{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":separateMajorReleases",
    "group:allNonMajor"
  ],
  "packageRules": [
    {
      "description": "Delegate low-risk dependency merging to Mergify.",
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "automerge": false,
      "addLabels": ["automerge:enabled", "risk:low"]
    },
    {
      "description": "Preserve the existing non-breaking minor-update automation through Mergify.",
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "addLabels": ["automerge:enabled", "risk:low"]
    },
    {
      "matchPackageNames": ["/^@opentelemetry\\//"],
      "groupName": "OpenTelemetry packages",
      "automerge": false,
      "addLabels": ["automerge:enabled", "risk:low"]
    },
    {
      "matchPackageNames": ["/^@types\\//"],
      "groupName": "DefinitelyTyped packages",
      "automerge": false,
      "addLabels": ["automerge:enabled", "risk:low"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": false,
      "addLabels": ["automerge:enabled", "risk:low"]
    }
  ],
  "ignorePaths": ["**/node_modules/**", "**/dist/**"],
  "timezone": "Europe/Istanbul",
  "dependencyDashboard": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security", "risk:high", "requires-review"],
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "highest"
  }
}
